# Your Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# PostgreSQL connection string.
# Locally with Railway, use your Postgres service's DATABASE_PUBLIC_URL.
DATABASE_URL=

# Set to true ONLY if your Postgres host requires SSL (Render, Heroku, Supabase, etc.).
# Leave it off for Railway's public proxy.
# PGSSL=true

# Optional — if the SAME bot token is ever connected more than once at a
# time (e.g. this deployment plus a local dev run against a test server),
# set this to the one guild ID this process should actually act on. Every
# interaction from any other guild is silently ignored, so the two
# instances don't both respond to the same event. Leave unset for normal
# single-instance use (the default — no filtering).
# ACTIVE_GUILD_ID=

# ── Admin site login (src/styleGuide/) ──────────────────────────────────────
# Everything below is only needed if you want the web admin dashboard's
# login to work. The bot itself runs fine without any of it.

# Discord OAuth2 — from the SAME Discord application as DISCORD_TOKEN above,
# OAuth2 tab. DISCORD_REDIRECT_URI must also be added to that app's OAuth2
# "Redirects" list, exactly as set here.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# Comma-separated Discord user IDs allowed to log in to the admin site.
ADMIN_USER_IDS=

# Any long random string, used to sign the login session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Google OAuth2 — optional, a second login option alongside Discord.
# From Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Comma-separated Google account emails allowed to log in this way.
ADMIN_GOOGLE_EMAILS=

# ── Path to Glory mode (src/ptg/) ───────────────────────────────────────────
# Set to "ptg" so Lumi ONLY tracks [PTG] Twitch streams and posts the coaches'
# "[PTG] Live now" board. Every older feature stays in the code but is off,
# and DATABASE_URL (her own Postgres) isn't needed. Leave unset for the old bot.
# LUMI_MODE=ptg

# Path to Glory's Supabase Postgres connection string (Supabase → Connect →
# Session pooler). A database password lives in it: set it in Railway only.
# PTG_DATABASE_URL=

# Discord channel id for the "[PTG] Live now" board. Leave unset for no board.
# PTG_LIVE_CHANNEL_ID=

# Discord channel id for the purple "<coach> is now live!" messages (one per
# go-live). Can be the same channel as the board. Leave unset for none.
# PTG_ANNOUNCE_CHANNEL_ID=

# Days Twitch keeps past broadcasts, for the "On Twitch until" date (default 7).
# PTG_VOD_DAYS=7

# Session pings: Lumi @s each coach in this channel before their booked
# sessions (how long before is each coach's own setting on the site's mentor
# desk). Leave unset for no session pings.
# PTG_PING_CHANNEL_ID=

# Test: a Discord user id. Lumi DMs that person a sample session ping each time
# she starts. Remove it once you've seen it.
# PTG_PING_TEST_USER_ID=

# Twitch app login (same values the Coastal Clash checker used).
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
